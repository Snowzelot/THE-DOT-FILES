/* Catppuccin Mocha Rofi Theme (No Rounded Corners & Papirus Icons) */

* {
    /* Catppuccin Mocha Farbpalette */
    bg-col:       #1e1e2e;
    bg-col-light: #313244;
    border-col:   #89b4fa;
    selected-col: #45475a;
    blue:         #89b4fa;
    fg-col:       #cdd6f4;
    fg-col-light: #a6adc8;
    grey:         #6c7086;

    width: 600;
    font: "JetBrainsMono Nerd Font 11";

    /* Keine abgerundeten Ecken */
    border-radius: 0px;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 380px;
    border: 2px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 0px;
}

mainbox {
    background-color: @bg-col;
    children: [inputbar, listview];
    padding: 10px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    border-radius: 0px;
    padding: 2px;
    margin: 0px 0px 10px 0px;
}

prompt {
    background-color: @blue;
    padding: 6px 12px;
    text-color: @bg-col;
    border-radius: 0px;
    margin: 0px;
}

entry {
    padding: 6px 10px;
    text-color: @fg-col;
    background-color: @bg-col-light;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 0px;
    columns: 1;
    lines: 8;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col-light;
    border-radius: 0px;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element selected {
    background-color: @selected-col;
    text-color: @blue;
    border-radius: 0px;
}
